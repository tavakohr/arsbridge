{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tavakohr/arsbridge/schema/arsbridge_supplement_v4.schema.json",
  "title": "arsbridge supplement (format version 4)",
  "description": "Per-TLF extraction help for arsbridge's supplement mode. Conditions are typed CDISC ARS WhereClause objects, not strings. camelCase fields are ARS-shaped; snake_case fields are arsbridge control fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "supplement_version",
    "tlfs"
  ],
  "properties": {
    "supplement_version": {
      "const": 4,
      "description": "Format version. Must be 4 for this schema."
    },
    "validation_report": {
      "type": "string",
      "description": "Optional filename of the companion extraction_validation_report.json (two-phase workflow)."
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow": {
          "type": "string"
        },
        "instruction_version": {
          "type": "string"
        }
      }
    },
    "tlfs": {
      "type": "object",
      "description": "Named map of TLF number (e.g. \"14.1.1\") to its entry.",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/tlfEntry"
      }
    }
  },
  "definitions": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "variable",
        "comparator"
      ],
      "properties": {
        "dataset": {
          "type": "string"
        },
        "variable": {
          "type": "string"
        },
        "comparator": {
          "enum": [
            "EQ",
            "NE",
            "GT",
            "GE",
            "LT",
            "LE",
            "IN",
            "NOTIN",
            "CONTAINS"
          ]
        },
        "value": {
          "type": "array",
          "description": "Values as strings; an empty array means a missing-value test.",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "compoundExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicalOperator",
        "whereClauses"
      ],
      "properties": {
        "logicalOperator": {
          "enum": [
            "AND",
            "OR",
            "NOT"
          ]
        },
        "whereClauses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/whereClause"
          }
        }
      }
    },
    "whereClause": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "condition"
          ]
        },
        {
          "required": [
            "compoundExpression"
          ]
        }
      ],
      "properties": {
        "condition": {
          "$ref": "#/definitions/condition"
        },
        "compoundExpression": {
          "$ref": "#/definitions/compoundExpression"
        }
      }
    },
    "analysisSet": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "condition"
          ]
        },
        {
          "required": [
            "compoundExpression"
          ]
        }
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "condition": {
          "$ref": "#/definitions/condition"
        },
        "compoundExpression": {
          "$ref": "#/definitions/compoundExpression"
        }
      }
    },
    "analysisVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "variable"
      ],
      "properties": {
        "dataset": {
          "type": "string"
        },
        "variable": {
          "type": "string"
        }
      }
    },
    "methodId": {
      "enum": [
        "MTH_SUMMARY_STATISTICS_CONTINUOUS",
        "MTH_COUNT_AND_PERCENTAGE",
        "MTH_SUBJECT_COUNT",
        "MTH_KAPLAN_MEIER_ESTIMATE",
        "MTH_AE_FREQUENCY_COUNT",
        "MTH_LISTING"
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "order"
      ],
      "oneOf": [
        {
          "required": [
            "condition"
          ]
        },
        {
          "required": [
            "compoundExpression"
          ]
        }
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "condition": {
          "$ref": "#/definitions/condition"
        },
        "compoundExpression": {
          "$ref": "#/definitions/compoundExpression"
        }
      }
    },
    "groupingFactor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupingDataset",
        "groupingVariable",
        "dataDriven"
      ],
      "properties": {
        "groupingDataset": {
          "type": "string"
        },
        "groupingVariable": {
          "type": "string"
        },
        "dataDriven": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/group"
          }
        }
      }
    },
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "enum": [
            "analysisSet",
            "group",
            "whereClause"
          ]
        },
        "whereClause": {
          "$ref": "#/definitions/whereClause"
        }
      }
    },
    "analysisEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rowLabel"
      ],
      "anyOf": [
        {
          "required": [
            "variable"
          ]
        },
        {
          "required": [
            "suppress"
          ],
          "properties": {
            "suppress": {
              "const": true
            }
          }
        }
      ],
      "properties": {
        "rowLabel": {
          "type": "string"
        },
        "variable": {
          "$ref": "#/definitions/analysisVariable"
        },
        "suppress": {
          "type": "boolean",
          "description": "true removes the matching parsed stub row entirely (a row the parser should not have read as live). Honoured only with supplement_trust = \"prefer_supplement\"."
        },
        "whereClause": {
          "$ref": "#/definitions/whereClause"
        },
        "methodId": {
          "$ref": "#/definitions/methodId"
        },
        "parentRowLabel": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "$ref": "#/definitions/denominator"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        }
      }
    },
    "listingColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "variable"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "variable": {
          "$ref": "#/definitions/analysisVariable"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "type": "string"
        }
      }
    },
    "sortKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "variable"
      ],
      "properties": {
        "dataset": {
          "type": "string"
        },
        "variable": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "ASC",
            "DESC"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "anchors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firstRowLabel": {
          "type": "string"
        },
        "lastRowLabel": {
          "type": "string"
        },
        "rowCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blueprintStatus": {
          "type": "string"
        },
        "reviewItems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tlfEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "analysis_type",
        "is_supported"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "outputType": {
          "enum": [
            "TABLE",
            "LISTING",
            "FIGURE"
          ]
        },
        "analysis_type": {
          "enum": [
            "CONTINUOUS",
            "CATEGORICAL",
            "CATEGORICAL_HIERARCHICAL",
            "MIXED_SUMMARY",
            "SUBJECT_COUNT",
            "SURVIVAL",
            "AE_FREQUENCY",
            "SHIFT_TABLE",
            "LISTING",
            "FIGURE",
            "MODEL_BASED",
            "OTHER"
          ]
        },
        "methodId": {
          "$ref": "#/definitions/methodId"
        },
        "is_supported": {
          "type": "boolean"
        },
        "unsupported_reason": {
          "type": "string"
        },
        "analysisSet": {
          "$ref": "#/definitions/analysisSet"
        },
        "recordFilter": {
          "$ref": "#/definitions/whereClause"
        },
        "groupings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/groupingFactor"
          }
        },
        "includeTotal": {
          "type": "boolean"
        },
        "columnHierarchy": {
          "$ref": "#/definitions/columnHierarchy"
        },
        "analyses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/analysisEntry"
          }
        },
        "listingColumns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/listingColumn"
          }
        },
        "sorting": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sortKey"
          }
        },
        "anchors": {
          "$ref": "#/definitions/anchors"
        },
        "provenance": {
          "$ref": "#/definitions/provenance"
        },
        "statisticRows": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/statisticRow"
          },
          "description": "Optional. What the rows naming statistics mean, where the label alone could not say."
        }
      },
      "not": {
        "required": [
          "columnHierarchy",
          "includeTotal"
        ],
        "properties": {
          "includeTotal": {
            "const": true
          }
        }
      }
    },
    "columnNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "level",
        "order",
        "nodeType"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "parentId": {
          "type": "string",
          "description": "id of the spanning parent node; absent for a top-level column."
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "description": "Display order among siblings."
        },
        "nodeType": {
          "enum": [
            "GROUP",
            "LEAF",
            "SUBTOTAL",
            "GRAND_TOTAL"
          ],
          "description": "GROUP spans children; LEAF is a detail column; SUBTOTAL is a per-parent total computed from the PARENT's condition (never by summing children); GRAND_TOTAL is the analysis-set column."
        },
        "groupingDataset": {
          "type": "string"
        },
        "groupingVariable": {
          "type": "string"
        },
        "condition": {
          "$ref": "#/definitions/condition"
        },
        "compoundExpression": {
          "$ref": "#/definitions/compoundExpression"
        },
        "totalStrategy": {
          "enum": [
            "condition_based",
            "analysis_set"
          ]
        }
      }
    },
    "columnHierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "nodes"
      ],
      "description": "Hierarchical/asymmetric result-column tree. Use only when a header level nests under another (a parent cohort spanning conditioned child columns). Flat single-axis tables keep using groupings + includeTotal.",
      "properties": {
        "mode": {
          "enum": [
            "NESTED",
            "ASYMMETRIC_NESTED"
          ]
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/definitions/columnNode"
          }
        }
      }
    },
    "statisticRow": {
      "type": "object",
      "description": "What a shell row that names STATISTICS means, when the label grammar could not read it. Optional and additive: a supplement written before this existed is unchanged and still valid. This may propose MEANING only -- it may never name an ARS operation or an engine statistic name, and only status='reviewed' is ever applied.",
      "additionalProperties": false,
      "required": [
        "row_label",
        "semantic_tokens",
        "status",
        "source"
      ],
      "properties": {
        "row_label": {
          "type": "string",
          "minLength": 1,
          "description": "The stub text exactly as the shell writes it. Rows are matched by LABEL, never by index."
        },
        "semantic_tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "count",
              "pct",
              "mean",
              "sd",
              "se",
              "median",
              "q1",
              "q3",
              "min",
              "max",
              "cv",
              "geomean",
              "ci_low",
              "ci_high",
              "events",
              "pvalue"
            ]
          },
          "description": "The statistics the row shows, in the order it shows them. Duplicates are meaningful and are kept. These are SEMANTIC names: arsbridge chooses the ARS operation from the row's method, so an OP_* id or an engine name (N, p25, conf.low) is rejected here."
        },
        "status": {
          "enum": [
            "proposal",
            "reviewed"
          ],
          "description": "Only 'reviewed' is applied. A 'proposal' is recorded and reported, and binds nothing."
        },
        "source": {
          "enum": [
            "supplement",
            "llm"
          ],
          "description": "Provenance only. It never decides whether the row binds -- status does that alone."
        },
        "reviewed_by": {
          "type": "string",
          "description": "Who reviewed it. REQUIRED when status is 'reviewed'."
        },
        "override": {
          "type": "boolean",
          "default": false,
          "description": "Per-row. When the label ALSO resolves and disagrees, the label wins unless this is true. Only a reviewed row may set it true."
        },
        "expected_scope": {
          "enum": [
            "continuous",
            "categorical"
          ],
          "description": "A cross-check, never an input: scope is the method's property. A disagreement is reported and never overrides the method."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "For ordering a review queue. Never gates acceptance."
        },
        "generator": {
          "type": "string",
          "description": "Model or assistant that produced a proposal."
        },
        "evidence": {
          "type": "string",
          "description": "What the proposer read. Free text, never parsed."
        },
        "proposed_at": {
          "type": "string",
          "description": "ISO-8601 UTC."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "reviewed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reviewed_by"
            ],
            "properties": {
              "reviewed_by": {
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "override": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
