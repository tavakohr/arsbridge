^arsbridge\.Rproj$
^\.Rproj\.user$
^\.claude$
^\.env$

# Repo furniture that is not package source
^LICENSE\.md$
^README\.Rmd$
^CONTRIBUTING\.md$
^CODE_OF_CONDUCT\.md$
^cran-comments\.md$
^CRAN-RELEASE$
^codecov\.yml$
^codemeta\.json$
^\.github$
^adr$
^tools$
^data-raw$
^revdep$

# Documentation site
^_pkgdown\.yml$
^docs$
^pkgdown$

# Local working notes and their top-level guards (see .gitignore)
^notes$
^HANDOFF_.*\.md$
^CLAUDE_.*\.md$
^PLAN_.*\.md$
^REVIEW_.*\.md$
^REEVALUATION_.*\.md$
^IMPROVEMENTS_.*\.md$

# Workspace folders: study material in, run output out
^inputs$
^outputs$
^\.siera_ref$
^\.align_backup$

# Scratch
^probe_.*\.R$
^scratch_.*\.R$
^run_.*\.R$
^tmp_.*$
