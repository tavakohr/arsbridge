.DS_Store

# Local-only sensitive
.Renviron
.env
.claude/

# Evaluation / review working docs (not part of the package)
evaluation/
IMPROVEMENTS_shell_spec_robustness.md
REVIEW_p0-parsing_branch.md
REEVALUATION_p0-parsing_premerge.md

# Build artifacts
inst/doc/
docs/
/*.tar.gz
/*.tgz
/*.Rcheck/

# Study-specific working dirs (NEVER commit client data)
#
# inputs/ is DEFAULT-DENY. It holds the shared APX-DRM-301 practice files,
# which are synthetic and tracked; anything else dropped there is presumed
# to be real study material and must never reach a commit. Listing the
# permitted files (rather than banning risky extensions) means a sponsor
# document copied in under ANY name is ignored by default -- `git add -A`
# cannot sweep it in. To add a genuinely shareable input, allowlist it
# below; to commit one deliberately, `git add -f` it.
inputs/*
!inputs/README.md
!inputs/ADaM.zip
!inputs/APX-DRM-301_*
!inputs/adam_spec_APX-DRM-301.xlsx

# Local planning / handoff notes. These describe work against real studies
# and are written for one machine, not for the repo. Kept out of commits by
# default; `git add -f` if one is ever genuinely worth publishing.
HANDOFF_*.md

# Redacted transfer artifacts from a restricted machine (tools/README_privacy_transfer.md).
# Structure-only by construction, but they describe a real study and belong to
# the debugging session, not to the package.
digest.json
ars_digest.json
diagnostics_redacted.csv
*_digest.json
*_redacted.csv

RWE_error/
# suprev/ holds local Copilot working files (blueprints, instruction
# drafts, conformance notes) tied to a specific study -- never committed.
suprev/
inputs/ADaM/
outputs/
.align_backup/
inputs/.shell_backup/
graphify-out/
~$*
scratch_*.R
run_*.R
.siera_ref/
